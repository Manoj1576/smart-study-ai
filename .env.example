# Smart Study AI Environment Variables

# Optional: Custom API URL for Production Backend Deployment (if backend is hosted on a separate URL like Render, Railway, Vercel Functions, etc.)
# If left empty, API requests default to relative paths (/api) or local dev proxy.
VITE_API_BASE_URL=

# Backend OpenAI Key (Set this in server/.env or production host environment settings)
OPENAI_API_KEY=your_openai_api_key_here
